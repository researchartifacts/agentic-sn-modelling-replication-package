{
  "description": "Five CSV files, comma-separated. Each starts with a header row naming every column of the file below, lower-case, in the order shown; every further row is one record. * marks a column SNRM requires; any other cell may be left blank. A number is plain digits with an optional . fraction (1200, 0.05): no thousands separators, and no units or other text in the cell.",
  "files": [
    {
      "file": "network_meta.csv",
      "columns": [
        {
          "name": "period_length_value",
          "required": true,
          "kind": "INTEGER",
          "note": "length of one simulation period, in period_length_unit"
        },
        {
          "name": "period_length_unit",
          "required": true,
          "kind": "TIME_UNIT",
          "note": "unit of the period length"
        },
        {
          "name": "horizon_periods",
          "required": true,
          "kind": "INTEGER",
          "note": "number of periods simulated"
        },
        {
          "name": "rounding_policy",
          "required": false,
          "kind": "ROUNDING_POLICY",
          "note": "how durations round to whole periods; default NEAREST"
        },
        {
          "name": "name",
          "required": false,
          "kind": "TEXT",
          "note": "the network's own name"
        }
      ]
    },
    {
      "file": "nodes.csv",
      "columns": [
        {
          "name": "name",
          "required": true,
          "kind": "TEXT",
          "note": "unique node name"
        },
        {
          "name": "type",
          "required": true,
          "kind": "NODE_TYPE",
          "note": "SUPPLIER, PLANT, DC or CUSTOMER"
        },
        {
          "name": "capacity_value",
          "required": false,
          "kind": "INTEGER",
          "note": "rate: units per capacity_time_unit; blank = uncapped"
        },
        {
          "name": "capacity_time_unit",
          "required": false,
          "kind": "TIME_UNIT",
          "note": "denominator of capacity_value"
        },
        {
          "name": "processing_time_value",
          "required": false,
          "kind": "INTEGER",
          "note": "duration in processing_time_unit"
        },
        {
          "name": "processing_time_unit",
          "required": false,
          "kind": "TIME_UNIT",
          "note": "unit of processing_time_value"
        },
        {
          "name": "fixed_cost",
          "required": false,
          "kind": "INTEGER",
          "note": "cost per period"
        },
        {
          "name": "var_cost",
          "required": false,
          "kind": "DECIMAL2",
          "note": "cost per unit"
        },
        {
          "name": "failure_prob",
          "required": false,
          "kind": "DECIMAL2",
          "note": "probability in [0, 1]"
        },
        {
          "name": "region",
          "required": false,
          "kind": "TEXT",
          "note": "region tag"
        },
        {
          "name": "lat",
          "required": false,
          "kind": "DECIMAL2",
          "note": "latitude in degrees"
        },
        {
          "name": "lng",
          "required": false,
          "kind": "DECIMAL2",
          "note": "longitude in degrees"
        },
        {
          "name": "pos_x",
          "required": false,
          "kind": "NUMBER",
          "note": "editor canvas x (not geography)"
        },
        {
          "name": "pos_y",
          "required": false,
          "kind": "NUMBER",
          "note": "editor canvas y (not geography)"
        },
        {
          "name": "caption",
          "required": false,
          "kind": "TEXT",
          "note": "annotation drawn under the name"
        },
        {
          "name": "caption_visible",
          "required": false,
          "kind": "BOOLEAN",
          "note": "true/false; blank = visible"
        }
      ]
    },
